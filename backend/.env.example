DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=ecommerce
DB_POOL_SIZE=10
PORT=3000

# Generate your own random string (32+ chars, enforced at boot) -
# never reuse this example value.
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
# Separate from JWT_SECRET_KEY on purpose - generate a different
# random 32+ char string, don't reuse the one above.
OTP_HASH_SECRET=change-me-to-a-different-long-random-string-32-chars
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION_DAYS=30
OTP_EXPIRATION_MINUTES=5

# Leave empty locally - Sentry stays fully off without a DSN.
SENTRY_DSN=
NODE_ENV=development
CORS_ORIGIN=*

# sms.ir - OTP falls back to console.log automatically if either of
# these is missing. SMSIR_OTP_TEMPLATE_ID must be created by you in
# the sms.ir panel (Verify/template-based send).
SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE_ID=

# ZarinPal - sandbox mode uses sandbox.zarinpal.com (fake payments,
# safe to test against).
ZARINPAL_MERCHANT_ID=
ZARINPAL_MODE=sandbox

# Must be reachable from the internet for ZarinPal's callback to work -
# localhost only works behind a tunnel (ngrok or similar).
BACKEND_URL=http://localhost:3000
# Leave empty to get plain JSON responses from payment callbacks
# instead of a redirect (useful before a frontend exists).
FRONTEND_URL=

# Where uploaded product images are stored - relative to the working
# directory or absolute (e.g. a volume shared by several instances).
# Served publicly under /uploads.
UPLOAD_DIR=uploads

# How long a ZarinPal payment session stays open before the maintenance
# job cancels the order and gives its stock back.
PAYMENT_WINDOW_MINUTES=15

# Hard timeout for every call to the payment gateway, in milliseconds.
ZARINPAL_TIMEOUT_MS=10000

# Optional: point the gateway at another host (a sandbox, or a local
# mock while developing/testing). Leave empty to use the real endpoints
# selected by ZARINPAL_MODE.
ZARINPAL_API_BASE=
ZARINPAL_GATEWAY_BASE=

# --- Phase 4: deployment safety ---------------------------------------
# How many reverse proxies sit in front of this app (1 for a single
# Nginx), or a list of trusted proxy addresses/CIDRs. Empty = trust
# nothing, which is right when the app is exposed directly. Without
# this, every client behind the proxy shares one rate-limit bucket.
TRUST_PROXY=

# Where rate-limit counters live. "memory" is per-process (fine for a
# single instance); use "database" whenever more than one instance runs,
# otherwise each instance allows the full limit on its own.
THROTTLE_STORAGE=memory

# API docs: on by default in development, off in production. Set to true
# to publish them anyway - and set the two credentials below to put them
# behind basic auth when you do.
SWAGGER_ENABLED=
SWAGGER_USER=
SWAGGER_PASSWORD=

# Share of transactions Sentry traces (0 to 1). Defaults to 0.1 in
# production, 1 in development.
SENTRY_TRACES_SAMPLE_RATE=

# Required only by src/seeds/seed-admin.ts, and only if you really mean
# to create an admin account on a production database.
# ALLOW_PRODUCTION_SEED=true

# --- Money and tax -----------------------------------------------------
# Every amount in this project is an integer number of TOMAN: product
# prices, wallet balances, shipping costs, order totals. ZarinPal is
# called with currency IRT to match.
#
# VAT charged on goods (after discount), as a percentage. Shipping is
# not taxed. Set to 0 to switch tax off.
TAX_RATE_PERCENT=10

# Most cash a courier is asked to collect for a single order (Toman).
# Orders above this must be paid online.
COD_MAX_AMOUNT=20000000

# --- Order SMS ---------------------------------------------------------
# One approved sms.ir template per event. Leave any of them empty and
# that message is simply not sent (it is recorded as "skipped"), so the
# shop can switch them on one at a time.
#   ORDER   = invoice number, AMOUNT = total in Toman
#   TRACKING/CARRIER are also available in the "sent" template
SMSIR_ORDER_PLACED_TEMPLATE_ID=
SMSIR_ORDER_PAID_TEMPLATE_ID=
SMSIR_ORDER_SENT_TEMPLATE_ID=
SMSIR_ORDER_DELIVERED_TEMPLATE_ID=
SMSIR_ORDER_CANCELLED_TEMPLATE_ID=

# Optional: point sms.ir at a mock while developing or testing.
SMSIR_API_BASE=

# Days after delivery during which a customer can request a return.
RETURN_WINDOW_DAYS=7
