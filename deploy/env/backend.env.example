# tellcall API - production environment.
# Copy to /etc/tellcall/backend.env, fill in every CHANGE_ME, then:
#   chown root:tellcall /etc/tellcall/backend.env && chmod 640 /etc/tellcall/backend.env
# Plain KEY=value lines only: systemd reads this file directly.

NODE_ENV=production
PORT=3000

# A public portfolio demo: allows the Zarinpal sandbox and the nightly
# reset from seed data. Remove this line for a real shop.
DEMO_MODE=true

# nginx sits in front of the API. Without this every visitor would share
# one IP address for the rate limits, and one person mistyping a password
# would lock everyone out of signing in.
TRUST_PROXY=1

# --- database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=tellcall
DB_PASSWORD=CHANGE_ME
DB_DATABASE=tellcall
DB_POOL_SIZE=10

# --- secrets: generate each with `openssl rand -hex 32`
JWT_SECRET_KEY=CHANGE_ME
OTP_HASH_SECRET=CHANGE_ME
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION_DAYS=30
OTP_EXPIRATION_MINUTES=5

# --- public addresses
# BACKEND_URL is where payment callbacks and image links point, so it is the
# API as seen from outside: the store host plus /api.
BACKEND_URL=https://shop.aboutarvin.ir/api
FRONTEND_URL=https://shop.aboutarvin.ir
CORS_ORIGIN=https://shop.aboutarvin.ir,https://admin.shop.aboutarvin.ir

# --- files
# Outside the code directory, so a redeploy never touches uploaded images.
UPLOAD_DIR=/var/lib/tellcall/uploads

# --- payments
# Sandbox in the demo; any 36-character UUID is accepted as a merchant id.
ZARINPAL_MODE=sandbox
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000

# --- SMS
# Left empty in the demo: registration then answers 503 and visitors use the
# demo accounts shown on the portfolio page. Fill both in for a real shop.
SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE_ID=

# --- API docs stay off in production
SWAGGER_ENABLED=false
