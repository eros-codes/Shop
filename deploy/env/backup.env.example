# tellcall backups. Copy to /etc/tellcall/backup.env, then:
#   chown root:root /etc/tellcall/backup.env && chmod 600 /etc/tellcall/backup.env
# Every line is optional; the values shown are the defaults.

# Where the dumps are kept on the server, and how many of each kind
# (nightly, pre-deploy, pre-restore) stay. Kept by count, not age.
BACKUP_DIR=/var/backups/tellcall
BACKUP_KEEP=14

# Load every new dump into a scratch database before trusting it.
BACKUP_VERIFY=true

# --- off the server (strongly recommended) ---------------------------------
# An rclone remote and folder, e.g. tellcall-crypt:nightly. Make it a
# "crypt" remote layered over your storage (ArvanCloud Object Storage, any
# S3, an SFTP box at home) so the copy is encrypted before it leaves: it
# holds every customer's name, number and address. DEPLOY.md walks through
# it. Left empty, the backups share a disk with the shop and die with it.
BACKUP_RCLONE_REMOTE=
BACKUP_RCLONE_CONFIG=/etc/tellcall/rclone.conf
# Off-site copies older than this are deleted - only ever after a new one
# has arrived, so the remote is never left empty.
BACKUP_REMOTE_KEEP_DAYS=30

# --- being told when it fails ------------------------------------------------
# A dead man's switch (healthchecks.io, Uptime Kuma "push", ...). Pinged after
# every good backup, and on <url>/fail after a bad one; the service alerts
# you when the ping stops coming - which also catches backups that silently
# stopped running.
BACKUP_HEALTHCHECK_URL=

# --- only when MySQL is not on this server ----------------------------------
# Root's socket login is used by default. For a remote database, point this
# at a [client] file with user=, password=, host= (chmod 600).
BACKUP_MYSQL_DEFAULTS_FILE=
